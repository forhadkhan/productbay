# ProductBay Development Environment Configuration
# =================================================
# Copy this file to .env and adjust values for your local environment.
# The .env file should NOT be committed to version control.

# Development Mode
# When true: enqueued assets are versioned with the current time so edits
# are never served stale from the browser cache.
# When false or omitted: assets are versioned with their file modification
# time, which is stable and browser-cacheable in production.
PRODUCTBAY_DEV_MODE=false
